.vs/
.vscode/
.idea/

# Cleanup trash (safe to discard after review)
.cleanup-trash/

# τ² 桥接的隔离库与上传产物（不入库）
tests/benchmark/rag/tau2-kb/

# 测试运行产物（TRX 每次重新生成，不入库）
tests/TestResults/

# Python 评测脚本的编译缓存（2026-11-08 M0：两个 .pyc 曾被误暂存）
__pycache__/
*.pyc

