<Project Sdk="Microsoft.NET.Sdk">
  <!-- 共享测试件：脚本化模型与工具环装配器。
       放在这里而不是某个测试项目里，是因为 CoreTests（模块级）与 ApplicationTests（流程验收）
       都要用；任选一边当宿主，另一边就得复制一份，而**副本正是漂移的载体**。

       本工程不含任何 [Fact]，不是测试项目——它只被两个测试项目引用。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>AgentWorkbench.TestKit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Foundation\AgentWorkbench.Shared\AgentWorkbench.Shared.csproj" />
    <ProjectReference Include="..\..\src\Core\Runtime\AgentWorkbench.Runtime.Tools\AgentWorkbench.Runtime.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentWorkbench.CoreTests" />
    <InternalsVisibleTo Include="AgentWorkbench.ApplicationTests" />
  </ItemGroup>
</Project>
