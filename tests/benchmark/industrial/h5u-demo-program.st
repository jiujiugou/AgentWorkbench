(* ============================================================
   汇川 H5U 演示程序 — 用于给 NitroGateway 提供"半真"数据源
   语言：ST（结构化文本，IEC 61131-3）
   用法：AutoShop 新建 H5U 工程 → 全局变量表按 h5u-point-table.csv 建变量
        → 新建 POU，语言选 ST → 粘贴本文件 → 编译 → 下载到仿真器 → 切 RUN
   ------------------------------------------------------------
   给 C# 程序员的两个关键概念（和写普通程序不一样）：
   1. 循环扫描：PLC 不是从头跑到尾就结束，而是「读输入 → 执行本程序 → 写输出」
      周而复始，周期通常几毫秒到几十毫秒。本文件里的每一行每个周期都会执行一次。
   2. 因此：写在程序里的赋值是"持续生效"的。上位机写进去的值，
      如果这里也在写，就会被改回去 —— 这正是我们要验证的现象。
   ============================================================ *)


(* ---------- 最小可跑版：先让这个跑通，再往下加 ----------
PROGRAM PMAIN
VAR
    tick : INT := 0;
END_VAR

    tick := tick + 1;
    gvCycleCounter := tick;

END_PROGRAM
------------------------------------------------------------ *)


PROGRAM PMAIN
VAR
    (* 内部状态 *)
    tick        : INT  := 0;      (* 扫描周期计数 *)
    phase       : INT  := 0;      (* 正弦相位 0-359 *)
    initialized : BOOL := FALSE;  (* 首次扫描标志，自己实现，不依赖厂商系统位 *)
    secTick     : INT  := 0;      (* 秒计数，用于慢速动作 *)
END_VAR


    (* ============ 1. 扫描周期计数 ============
       用途：验证「轮询周期 vs PLC 扫描周期」(ENG-004)、订阅滞后 (OPC-004)
       现象：上位机若轮询快于扫描周期，会连续读到同一个值 *)
    tick := tick + 1;
    IF tick > 30000 THEN tick := 0; END_IF;   (* 防止 INT 溢出 *)
    gvCycleCounter := tick;


    (* ============ 2. 首次扫描初始化 ============
       只在第一个扫描周期执行一次，之后不再写这些寄存器，
       这样上位机才能真正写进去（否则会被程序持续覆写） *)
    IF NOT initialized THEN
        gvInt16_Known    := 4660;     (* 0x1234，字节序校验 ADDR-002 *)
        gvInt16_Negative := -1;       (* 有符号/无符号校验 ADDR-004 *)
        gvReal_Known     := 1.0;      (* 0x3F800000，32位字序+浮点 ADDR-003 *)
        gvDint_Known     := 100000;   (* 32位整数字序 ADDR-003 *)
        gvScaled_Temp    := 8500;     (* 放大100存储，表示 85.00℃ ADDR-006 *)
        gvReadOnly       := 123;      (* 只读区，写入应失败 ENG-001 *)
        gvTypeGuard      := 0;        (* 32位写入破坏邻居测试 ENG-003 *)
        gvTypeNeighbor   := 7777;     (* 邻居，观察是否被误改 *)
        gvCoil0          := FALSE;    (* 位/字混淆测试 ADDR-005 *)
        gvCoil1          := TRUE;
        gvCoil2          := FALSE;
        gvCoil3          := TRUE;
        initialized      := TRUE;
    END_IF;


    (* ============ 3. 正弦波动 ============
       用途：让数据真的在动，才有"采集"的意义，也才能做死点/漂移检测
       范围：0 ~ 1000
       需要在变量表新增：D11 -> gvWave (INT) *)
    phase := (phase + 1) MOD 360;
    gvWave := REAL_TO_INT( 500.0 + 500.0 * SIN( INT_TO_REAL(phase) * 3.14159265 / 180.0 ) );


    (* ============ 4. 死点（永远不变） ============
       用途：验证数据质量诊断能否检出"长期无变化的点"
       需要在变量表新增：D12 -> gvDeadPoint (INT) *)
    gvDeadPoint := 1234;   (* 恒定值，永不变化 *)


    (* ============ 5. 周期性覆写（关键，验证写值闭环） ============
       用途：这是 Modbus Slave 模拟不出来的现象。
       上位机往 gvProgramWrite 写一个值，几十毫秒后就会被这里改掉。
       用来验证你的「回读校验」和「多主站冲突」处理是否正确 (ENG-002)。 *)
    secTick := secTick + 1;
    IF secTick >= 100 THEN          (* 约每 100 个扫描周期覆写一次 *)
        gvProgramWrite := tick;     (* 写成当前 tick，上位机写入的值会被冲掉 *)
        secTick := 0;
    END_IF;


    (* ============ 6. 线圈翻转 ============
       用途：位区也在变化，便于测订阅上报 *)
    IF (tick MOD 500) = 0 THEN
        gvCoil0 := NOT gvCoil0;
    END_IF;

END_PROGRAM
