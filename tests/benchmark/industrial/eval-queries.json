{
  "version": "0.1",
  "note": "工业报警处置 RAG 检索评测集。正例来自 fault-cases.json（query -> case id），负例为语料库明确未覆盖的工业问题。",
  "source": "tests/benchmark/industrial/fault-cases.json",
  "corpus": "tests/corpus/industrial/*.pdf",
  "metrics": {
    "recallAt5": {
      "threshold": 0.9,
      "note": "正例期望文档出现在 top5 的比例；阈值取自 fault-cases.json 的 targetTop3"
    },
    "mrr": {
      "threshold": 0.7,
      "note": "正例期望文档的倒数排名均值；阈值取自 fault-cases.json 的 targetTop1"
    },
    "negativeFalseHitRate": {
      "threshold": 0.2,
      "note": "负例返回任何命中（top5 非空）的比例，越低越好"
    },
    "vectorContribution": {
      "threshold": null,
      "note": "仅观测：RRF 相对纯 FTS 的 Recall@5 差值"
    }
  },
  "queries": [
    {
      "id": "MB-001",
      "query": "读保持寄存器返回 02 异常码，怎么办",
      "expected": "MB-001",
      "kind": "positive"
    },
    {
