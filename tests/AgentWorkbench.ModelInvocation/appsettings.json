{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Provider": {
    "BaseUrl": "",
    "ApiKey": "",
    "Model": "",
    "Temperature": 0.7,
    "SupportsTools": true
  },
  "Storage": {
    "DataDir": "data",
    "UploadsDir": "data/uploads",
    "DbPath": "data/agentworkbench.db",
    "MaxFileBytes": 31457280,
    "MaxPages": 200
  },
  "Harness": {
    "ModelRuntime": {
      "RequestTimeoutSeconds": 120,
      "MaxRetries": 2,
      "RetryBaseDelayMilliseconds": 200,
      "MaxConcurrentRequests": 8
    }
  }
}
