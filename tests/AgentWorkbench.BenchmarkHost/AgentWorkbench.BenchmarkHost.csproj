<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentWorkbench.BenchmarkHost</RootNamespace>
  </PropertyGroup>

  <!--
    基准夹具（不是底座能力，也不是产品面）：
    对外暴露 OpenAI 兼容的 /v1/chat/completions，内部把请求转发到
    Providers（端点解析）+ ModelRuntime（超时/重试/闸门/用量）。

    放在 tests/ 下是有意为之：
      - 它服务于基准，不服务于运行底座；
      - 架构测试的 AssemblyNames 是硬编码的 src 清单，看不到本目录，
        因此本项目的存在不会改动任何架构边界。
    先例：tests/AgentWorkbench.MockLlm（同样是 tests/ 下的模型服务）。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentWorkbench.Providers\AgentWorkbench.Providers.csproj" />
    <ProjectReference Include="..\..\src\AgentWorkbench.ModelRuntime\AgentWorkbench.ModelRuntime.csproj" />
    <!-- ChatClientFactory 解析端点时读数据库（激活供应商），因此需要数据层。 -->
    <ProjectReference Include="..\..\src\AgentWorkbench.Persistence\AgentWorkbench.Persistence.csproj" />
  </ItemGroup>

</Project>
