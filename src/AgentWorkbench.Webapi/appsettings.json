{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Provider": {
    "BaseUrl": "https://api.deepseek.com/v1",
    "ApiKey": "",
    "Model": "deepseek-chat",
    "EmbeddingModel": "",
    "Temperature": 0.7,
    "SupportsTools": true,
    "SystemPrompt": "你是 AgentWorkbench 的通用 AI 助手，回答准确、简洁，必要时使用工具。"
  },
  "Storage": {
    "DataDir": "data",
    "UploadsDir": "data/uploads",
    "DbPath": "data/agentworkbench.db",
    "MaxFileBytes": 31457280,
    "MaxPages": 200
  },
  "Knowledge": {
    "Provider": "local",
    "TopK": 5,
    "CandidateK": 20,
    "MinFusedScore": 0.0,
    "MaxVectorDistance": 0.6,
    "Embedding": {
      "Provider": "ollama",
      "BaseUrl": "http://localhost:11434",
      "Model": "bge-m3",
      "ApiKey": "",
      "Dimensions": 1024
    },
    "Rerank": {
      "Enabled": false
    }
  }
}
