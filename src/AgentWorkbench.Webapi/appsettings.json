{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Provider": {
    "BaseUrl": "https://api.deepseek.com/v1",
    "ApiKey": "",
    "Model": "deepseek-chat",
    "EmbeddingModel": "",
    "Temperature": 0.7,
    "SupportsTools": true,
    "SystemPrompt": "你是 AgentWorkbench 的通用 AI 助手，回答准确、简洁，必要时使用工具。"
  },
  "Storage": {
    "DataDir": "data",
    "UploadsDir": "data/uploads",
    "DbPath": "data/agentworkbench.db",
    "MaxFileBytes": 31457280,
    "MaxPages": 200
  },
  "Harness": {
    "Memory": {
      "SessionEnabled": true,
      "SessionTtlMinutes": 1440,
      "MaxCachedSessions": 1000,
      "EvictionSweepSeconds": 60,
      "LongTermEnabled": true,
      "LongTermScope": "session",
      "MaxMemoryChars": 2000,
      "RecallCandidateK": 20,
      "LongTermRetentionDays": 0
    },
    "Tools": {
      "Whitelist": [
        "get_current_time",
        "calculator",
        "search_knowledge",
        "list_documents",
        "remember",
        "recall"
      ]
    },
    "Approval": {
      "Default": "Auto",
      "Overrides": {}
    }
  },
  "Knowledge": {
    "Provider": "local",
    "TopK": 5,
    "CandidateK": 20,
    "MinFusedScore": 0.0,
    "MaxVectorDistance": 0.6,
    "Embedding": {
      "Provider": "ollama",
      "BaseUrl": "http://localhost:11434",
      "Model": "bge-m3",
      "ApiKey": "",
      "Dimensions": 1024
    },
    "Rerank": {
      "Enabled": false
    }
  },
  "Workflow": {
    "DefaultPromptContent": "你是文档分析助手。只依据给定的【文档上下文】与【检索到的依据】作答，输出结构化的结论与建议。引用依据时用 [编号] 标注，编号必须与【检索到的依据】中的编号一致，不得引用不存在的编号，不得编造依据中不存在的参数、条款或事实。依据不足以支撑结论时，明确标注「依据不足，需人工确认」并列出仍需确认的项，不得用通用经验冒充依据。"
  }
}
