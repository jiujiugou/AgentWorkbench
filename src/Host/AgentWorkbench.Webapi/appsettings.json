{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Provider": {
    "BaseUrl": "https://api.deepseek.com/v1",
    "ApiKey": "",
    "Model": "deepseek-chat",
    "EmbeddingModel": "",
    "Temperature": 0.7,
    "SupportsTools": true,
    "SystemPrompt": "你是 AgentWorkbench 的通用 AI 助手，回答准确、简洁，必要时使用工具。"
  },
  "Storage": {
    "DataDir": "data",
    "UploadsDir": "data/uploads",
    "DbPath": "data/agentworkbench.db",
    "MaxFileBytes": 31457280,
    "MaxPages": 200
  },
  "Harness": {
    "Loop": {
      "MaxIterations": 6,
      "TimeoutSeconds": 300,
      "MaxRepeatedToolCalls": 3,
      "MaxTokensPerRun": 0
    },
    "Memory": {
      "SessionEnabled": true,
      "SessionTtlMinutes": 1440,
      "MaxCachedSessions": 1000,
      "EvictionSweepSeconds": 60,
      "LongTermEnabled": true,
      "LongTermScope": "session",
      "MaxMemoryChars": 2000,
      "RecallCandidateK": 20,
      "LongTermRetentionDays": 0
    },
    "Tools": {
      "Whitelist": [
        "get_current_time",
        "calculator",
        "search_knowledge",
        "list_documents",
        "remember",
        "recall",
        "propose_action",
        "mcp__everything__*"
      ]
    },
    "Approval": {
      "Default": "Auto",
      "Overrides": {}
    }
  },
  "Knowledge": {
    "Provider": "local",
    "TopK": 5,
    "CandidateK": 20,
    "MaxVectorDistance": 0.6,
    "RefuseMargin": null,
    "SufficientDistance": null,
    "CitationCoverageThreshold": null,
    "UnsupportedRatio": 1.0,
    "Embedding": {
      "Provider": "openai",
      "BaseUrl": "https://api.siliconflow.cn/v1",
      "Model": "BAAI/bge-m3",
      "ApiKey": "",
      "Dimensions": 1024,
      "TimeoutSeconds": 20,
      "MaxRetryAttempts": 2
    },
    "Rerank": {
      "Enabled": false
    }
  },
  "Actions": {
    "ActionSet": "ErpActionSet",
    "Store": "Sqlite",
    "Gitea": {
      "BaseUrl": "",
      "Token": "",
      "DefaultOwner": "",
      "DefaultRepo": "",
      "TimeoutSeconds": 15,
      "AllowWrites": false
    }
  },
  "Identity": {
    "SeedDemo": true
  },
  "Mcp": {
    "Enabled": false,
    "Servers": [
      {
        "Name": "everything",
        "Enabled": true,
        "Transport": "stdio",
        "Command": "npx",
        "Arguments": [ "-y", "@modelcontextprotocol/server-everything" ],
        "Environment": {},
        "InheritEnvironment": true,
        "Endpoint": null,
        "Headers": {},
        "AllowTools": []
      }
    ]
  }
}
