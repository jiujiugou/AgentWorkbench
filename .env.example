# 复制为 .env 后填写。所有值均为 OpenAI 兼容端点配置。
# 环境变量中使用双下划线表示层级：Provider:BaseUrl -> Provider__BaseUrl
#
# 注意：模型现在也可在前端「设置」页在线增删/切换，无需重启。
# 下列 Provider__* 仅在数据库为空时作为首次启动的种子，之后以页面配置为准。

Provider__BaseUrl=https://api.deepseek.com/v1
Provider__ApiKey=
Provider__Model=deepseek-chat
Provider__EmbeddingModel=
Provider__Temperature=0.7

# 知识库（P1）。Embedding Provider: none | ollama | openai
# none = 只用 FTS5 全文检索；ollama = 本地 bge-m3（需 `ollama pull bge-m3`）
Knowledge__Provider=local
Knowledge__Embedding__Provider=none
Knowledge__Embedding__BaseUrl=http://localhost:11434
Knowledge__Embedding__Model=bge-m3
